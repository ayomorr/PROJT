# ------------------------------------------------------------------
# ScrollGuard — environment variables
# Copy this file to backend/.env and fill in the values.
# Never commit real secrets. The frontend never sees these values.
# ------------------------------------------------------------------

# Server port for the backend API
PORT=4000

# Full URL of the frontend (used for CORS + cookie domain in production)
FRONTEND_URL=http://localhost:5173

# URL where the browser extension should send usage data
EXTENSION_API_URL=http://localhost:4000/api

# Secret used to sign JSON Web Tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where the backup API token lives (used alongside cookies)
# Leave empty to disable token-based auth.
JWT_EXPIRES_IN=7d

# SQLite database file location (relative to backend/)
DATABASE_URL=./data/scrollguard.db

# ------------------------------------------------------------------
# AI coach (optional)
# If empty, ScrollGuard runs in "offline coach" mode and answers
# with its built-in rule-based coach. Set AI_API_KEY to use a
# real LLM. The AI_PROVIDER must be one of: `openai`, `openrouter`
# or any endpoint compatible with the OpenAI chat API.
# ------------------------------------------------------------------
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------
# Admin bootstrap
# When ADMIN_BOOTSTRAP=true, the server creates an admin user on
# first startup using the credentials below. Change them!
# ------------------------------------------------------------------
ADMIN_BOOTSTRAP=true
ADMIN_EMAIL=admin@scrollguard.app
ADMIN_PASSWORD=ChangeMeAdmin123!

# ------------------------------------------------------------------
# Demo mode (backend seed)
# `npm run seed` loads realistic demo usage data for a demo user.
# ------------------------------------------------------------------
DEMO_USER_EMAIL=demo@scrollguard.app
DEMO_USER_PASSWORD=demo1234