# Frontend environment — copy this to frontend/.env
# Values are inlined at build time (VITE_ prefix only).

# Base URL of the ScrollGuard API.
# In dev with `npm run dev`, Vite proxies /api to the backend, so keep this as /api.
VITE_API_URL=/api

# Demo mode: generates clearly-labelled sample data so the product can be
# evaluated without a backend. Never ship this enabled for real users.
VITE_DEMO_MODE=true